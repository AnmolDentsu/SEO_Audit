# ================================================================
# SEO AI Platform - local configuration
# ================================================================

# ---------------- Core ----------------
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///./seo_platform.db

# local worker | inline | cloud_run_job
JOB_EXECUTION_MODE=worker
WORKER_POLL_SECONDS=2
RUN_MAX_URLS=1000
CACHE_TTL_HOURS=12

# ---------------- Crawl ----------------
CRAWL_TIMEOUT_MS=45000
CRAWL_MAX_RETRIES=3
CRAWL_BACKOFF_BASE_SECONDS=2
CRAWL_CONCURRENCY=3
CRAWL_USER_AGENT=Mozilla/5.0 (compatible; SEOAnalysisBot/1.0; +https://example.com/bot)
BLOCK_PRIVATE_NETWORKS=true

# ================================================================
# AI / GEMINI AUTH
# ================================================================
# AI_MODE=off       -> deterministic SEO only
# AI_MODE=mock      -> no Google call; useful for tests
# AI_MODE=vertex    -> RECOMMENDED: Vertex AI + service account/ADC
# AI_MODE=api_key   -> optional Gemini Developer API mode
AI_MODE=off

# For AI_MODE=vertex:
# auto            -> use service-account file when GOOGLE_APPLICATION_CREDENTIALS
#                    is set; otherwise Application Default Credentials (ADC)
# service_account -> require GOOGLE_APPLICATION_CREDENTIALS
# adc             -> ignore service-account file and use ADC/runtime identity
VERTEX_AUTH_MODE=auto

# These aliases match the user's existing .env naming style.
# GOOGLE_CLOUD_PROJECT and GOOGLE_CLOUD_LOCATION are also accepted.
GCP_PROJECT_ID=
GCP_LOCATION=global

# LOCAL SERVICE-ACCOUNT MODE ONLY.
# Prefer an absolute path outside the repository. If you keep it in the project
# root temporarily, service_account*.json is gitignored by this repo.
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json

# OPTIONAL. This key is NOT used when AI_MODE=vertex.
# It is used only when AI_MODE=api_key.
GEMINI_API_KEY=

# Model aliases. GEMINI_MODEL is also accepted for MODEL_TEXT;
# EMBEDDING_MODEL is also accepted for MODEL_EMBEDDING.
MODEL_TEXT=gemini-3.5-flash
MODEL_EMBEDDING=gemini-embedding-2
EMBEDDING_DIMENSION=768
AI_MAX_OPPORTUNITIES=20

# ---------------- Cloud Run Job dispatch (optional production mode) ----------------
CLOUD_RUN_PROJECT=
CLOUD_RUN_REGION=us-central1
CLOUD_RUN_JOB_NAME=

# Frontend local dev reads this from frontend/.env if set.
VITE_API_BASE_URL=http://localhost:8000
